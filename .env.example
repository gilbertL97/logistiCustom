# Runtime
NODE_ENV=development
PORT=3000

# Database
DATABASE_DRIVER=prisma
DATABASE_URL=postgresql://licuser:change-me@localhost:5432/licensing
DB_PASSWORD=change-me

# License security
# Use at least 64 characters for JWT secrets.
JWT_SECRET=replace-with-a-random-secret-at-least-64-characters-long-1234567890
JWT_TTL_HOURS=12
APK_SECRET=replace-with-a-random-apk-secret-at-least-32-chars
GRACE_HOURS=48
TRIAL_DAYS=7
MAX_RENEWALS=3

# Admin authentication
ADMIN_JWT_SECRET=replace-with-a-random-admin-secret-at-least-64-characters-long-1234567890
ADMIN_TOKEN_TTL_HOURS=8
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me
